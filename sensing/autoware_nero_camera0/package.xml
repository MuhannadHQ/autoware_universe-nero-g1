<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autoware_nero_camera0</name>
  <version>0.44.2</version>
  <description>[nero camfront 2026-11-09] The forward wide camera as camera0: fisheye (Kannala-Brandt) -> pinhole rectification,
    one frame per lidar cycle, image_rect_color + camera_info for the 2D detector and image_projection_based_fusion</description>
  <maintainer email="ahmed.q@usenero.com">Ahmed Alqurashi</maintainer>
  <license>Apache License 2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>autoware_internal_msgs</exec_depend>
  <exec_depend>tier4_perception_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
